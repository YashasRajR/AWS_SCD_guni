# ============================================================
# AWS Student Community Day — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Runtime ---
NODE_ENV=development
PORT=4000
API_VERSION=v1

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scd_dev
DATABASE_SSL=false

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
PASSWORD_RESET_TOKEN_TTL=1h
EMAIL_VERIFICATION_TOKEN_TTL=24h

# --- Application URLs ---
PUBLIC_APP_URL=http://localhost:5173
VOLUNTEER_APP_URL=http://localhost:5174
ADMIN_APP_URL=http://localhost:5175

# --- Payments (Razorpay-shaped: key id + key secret + webhook secret.
# Test/sandbox mode is free to develop against; leave these blank and
# initiating a payment fails with a clear "not configured" error rather
# than faking an order. Live transactions carry Razorpay's standard fees —
# not "free forever" — verify current pricing before going live.) ---
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Email (SMTP — free/self-hostable: a Gmail app password, a free-tier
# relay like Brevo/Mailtrap, or any real mail server all work here. Leave
# EMAIL_SMTP_HOST blank to fall back to logging emails to the console
# instead of sending them, so local dev doesn't need real credentials.) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=AWS Student Community Day

# --- Storage (service boundary only in this phase) ---
STORAGE_BUCKET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=info
