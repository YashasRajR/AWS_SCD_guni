# Netlify / Cloudflare Pages caching. Vite content-hashes everything under
# /assets/ (e.g. index-C3010A5p.js), so those files never change under a
# given name -- safe to cache forever. index.html itself must always be
# revalidated or a deployed update never reaches returning visitors.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
