{
  "name": "student-community-day",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS Student Community Day 2026 — event platform monorepo (public web, admin portal, backend API).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"backend,web\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:all": "concurrently -n \"backend,web,admin\" -c \"blue,green,magenta\" \"npm run dev:backend\" \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "db:migrate": "node database/scripts/migrate.mjs up",
    "db:migrate:down": "node database/scripts/migrate.mjs down",
    "db:migrate:status": "node database/scripts/migrate.mjs status",
    "db:seed": "node database/scripts/seed.mjs",
    "db:reset": "node database/scripts/migrate.mjs reset && node database/scripts/seed.mjs",
    "start:web": "serve -s apps/web/dist -l ${PORT:-3000}",
    "start:admin": "serve -s apps/admin/dist -l ${PORT:-3001}"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "serve": "^14.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
