{
  "name": "student-community-day",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS Student Community Day 2026 — event platform monorepo (public web, volunteer portal, admin portal, backend API).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:volunteer": "npm run dev --workspace=apps/volunteer",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node database/scripts/migrate.mjs up",
    "db:migrate:down": "node database/scripts/migrate.mjs down",
    "db:migrate:status": "node database/scripts/migrate.mjs status",
    "db:seed": "node database/scripts/seed.mjs",
    "db:reset": "node database/scripts/migrate.mjs reset && node database/scripts/seed.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
